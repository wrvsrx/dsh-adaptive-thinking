{
  "name": "dsh-adaptive-thinking-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configure Adaptive Thinking per custom Anthropic Messages model in DeepSeek Harness.",
  "engines": { "dsh": ">=0.2.2-rc.3 <0.2.3-0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "operations.js", "client.js", "client.entry.js", "build-client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "test", "README.md"],
  "scripts": { "build": "node build-client.js", "test": "node build-client.js --check && node --test" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models"]
    }
  }
}
